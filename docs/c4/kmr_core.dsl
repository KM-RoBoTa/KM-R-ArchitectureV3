//
// kmr_core is the engine, linked into the control process. It owns the loop,
// the clock, the state, the schedules, the signal bus and the hardware
// contract; users never name it, kmr_api wraps it. N is a const generic;
// faults and tick flags are kept per History slot; the limit stage and the
// hidden Stages hooks run around the controllers; run_on returns RunError.
// The relations from kmr_api and
// kmr_adapters into the core are drawn here, because this file is included
// after theirs.

!element kmr.control {
    coreBuilder = component "kmr_core: builder" "Robot<CS>: dt, hold, controllers added on a schedule label, each add growing the schedules' type by one node. run_on(drivers) lends the hardware to one run and returns Ok for a shutdown and an emergency stop alike (SRS FR-1, FR-5.9)." "Rust, frunk HList, type-state"
    coreSchedules = component "kmr_core: schedules" "The six labels PreInit, Init, PostInit, First, EachTick, Last, generated by schedules! with one bucket HList each. A controller is routed to its bucket once, when added; per tick each bucket is walked in order, no compare, no dyn (SRS FR-1.1)." "Rust macro_rules, sealed traits"
    coreControllers = component "kmr_core: controller nodes" "Inline, InlineWith and Threaded: opaque nodes holding the controller fn and its context; Env lends &Time, &mut RobotState and &Sensors for one phase. Threaded nodes are stored, not spawned yet (SRS FR-1.2)." "Rust"
    coreRuntime = component "kmr_core: runtime" "Resets the bus, wires Ctrl-C, claims the hardware, runs the bring-up and PreInit, Init, PostInit, then loops read, First, EachTick, Last, write, sleep until a signal. The Powered guard ends every exit, unwind included, with torque off then close; a shutdown holds first (SRS FR-3, FR-4, FR-5, NFR-2)." "Rust"
    coreClock = component "kmr_core: clock" "Time: tick, dt, elapsed and overrun accounting. Never reads the system time: the runtime injects every instant. Deadlines are origin + k * dt; after an overrun missed slots are skipped, no catch-up (SRS FR-3.2, FR-3.3)." "Rust"
    coreSignal = component "kmr_core: signal bus" "Process-global, lock-free AtomicU8 level and AtomicPtr meta, raised by shutdown! and emergency_stop! from any depth or thread. Monotonic: an emergency stop never drops to a shutdown (SRS FR-4)." "Rust atomics, macro_rules"
    coreState = component "kmr_core: state" "RobotState: a write-only Desired staging area and a read-only History ring of HISTORY_DEPTH samples. Typed getters and setters over the sealed field set Q, Qd, Tau, Kp, Kd; no raw field is reachable (SRS FR-2)." "Rust, circular-buffer"
    coreLimits = component "kmr_core: limit stage" "Limit, Policy and Envelope per actuator, set on the builder. Each tick after Last, before the batch: an envelope breach clamps and sets envelope; a limit breach sets joint_limit, then Clamp, Warn or Abort (an emergency stop, no write); a non-finite value is never sent. A limit without a policy is refused at finalization (SRS FR-4.5, FR-13.5)." "Rust"
    coreHal = component "kmr_core: hardware contract" "The Hal trait an adapter implements: check, open, zero, ping, health, configure, read_all, torque_on, then read and write each tick, hold, torque_off, close. Speaks actuator indices, masks, opaque groups and a cadence; buses and protocols stay in the adapter. NoHardware simulates (SRS FR-5.1 to FR-5.10, FR-13.4)." "Rust traits"
    coreDriverSet = component "kmr_core: driver set" "The robot's hardware as an HList of Hal members. Each member claims its actuators; the plan rejects overlaps and gaps before any I/O. Steps walk head first, torque off in reverse. A debug-build audit catches a member touching an index it does not own (SRS FR-5.1, FR-6.4)." "Rust, frunk HList"
    coreErrors = component "kmr_core: errors" "StateError of the handles (NoSample before a first read), HardwareError naming the member and the step, RunError: Config (DtOutOfRange) or Hal (SRS FR-3.1, NFR-4)." "Rust, thiserror"

    coreBuilder -> coreSchedules "Inserts each controller into the bucket its label picks"
    coreSchedules -> coreControllers "Holds and walks"
    coreBuilder -> coreRuntime "Hands the scheduled robot and the drivers to"
    coreRuntime -> coreSchedules "Walks each phase bucket of"
    coreRuntime -> coreClock "Injects instants into, sleeps to the deadline of"
    coreRuntime -> coreSignal "Resets, then drains between phases"
    coreRuntime -> coreState "Records the sample into History, clears Desired after the write"
    coreRuntime -> coreDriverSet "Claims, brings up, reads, writes, holds and powers off through"
    coreRuntime -> coreLimits "Runs on the written values before the batch"
    coreBuilder -> coreLimits "Sets limits, policies and envelopes of"
    coreControllers -> coreState "Read and write through"
    coreControllers -> coreClock "Read"
    coreDriverSet -> coreHal "Calls each member through"
    coreDriverSet -> coreErrors "Fails with"
    coreState -> coreErrors "Fails with"

    apiBuilder -> coreBuilder "Wraps; run() ends in run_on of"
    apiHandles -> coreState "Wraps"
    apiHandles -> coreClock "Wraps"
    apiReexports -> coreState "Re-exports Q, Qd, Tau, Kp, Kd and the Field bound from"
    apiReexports -> coreSignal "Re-exports shutdown! and emergency_stop! from"
    apiErrors -> coreErrors "Converts"
    adaptersMember -> coreHal "Implements"

    group "kmr_core: builder" {
        coreRobot = component "robot::Robot<CS>" "The configuration and the Scheduled HList; add_control_fn, add_control_fn_with, add_control_fn_as_thread, set_dt, set_hold, run_on." "Rust struct" {
            tags "Code"
        }
    }

    group "kmr_core: schedules" {
        coreSchedule = component "schedule::Schedule" "Sealed marker of the six labels." "Rust trait" {
            tags "Code"
        }
        coreScheduled = component "schedule::Scheduled<..>" "One bucket HList per phase, HNil by default." "Rust struct, macro-generated" {
            tags "Code"
        }
        coreInsert = component "schedule::Insert<S, Node>" "One impl per label: appends the node to that label's bucket, once, at add time." "Rust trait, macro-generated" {
            tags "Code"
        }
        coreDrive = component "schedule::Drive" "One method per phase, called by the runtime." "Rust trait, macro-generated" {
            tags "Code"
        }
        coreRunPhase = component "schedule::RunPhase" "Walks one bucket, head first." "Rust trait" {
            tags "Code"
        }
    }

    group "kmr_core: controller nodes" {
        coreNodes = component "controllers::Inline, InlineWith, Threaded" "The nodes; fields pub(crate), constructors hidden." "Rust structs" {
            tags "Code"
        }
        coreFnTraits = component "controllers::ControlFn, ControlFnWith, ThreadFn" "The fn shapes a controller may have." "Rust traits" {
            tags "Code"
        }
        coreEnv = component "controllers::Env" "&Time, &mut RobotState, &Sensors for one phase walk." "Rust struct" {
            tags "Code"
        }
    }

    group "kmr_core: runtime" {
        coreRuntimeFn = component "runtime::runtime" "Entry: tracing, bus reset, Ctrl-C, then run_with on the real host; returns the Signal that ended the run." "Rust fn" {
            tags "Code"
        }
        coreHost = component "runtime::Host" "now, sleep_until, poll: the seam a scripted test host replaces." "Rust trait, private" {
            tags "Code"
        }
        corePowered = component "runtime::Powered" "Drop guard from open on: torque off, then close." "Rust struct, private" {
            tags "Code"
        }
    }

    group "kmr_core: clock" {
        coreTime = component "clock::Time" "Tick, dt, elapsed, deadlines and overrun counters; methods pub(crate)." "Rust struct" {
            tags "Code"
        }
    }

    group "kmr_core: signal bus" {
        coreSignalType = component "signal::Signal" "The raised kind and its call-site meta; reset() and drain()." "Rust struct" {
            tags "Code"
        }
        coreSignalMeta = component "signal::SignalMeta" "Reason, file and line of one call site, a static per expansion." "Rust struct" {
            tags "Code"
        }
    }

    group "kmr_core: state" {
        coreRobotState = component "state::RobotState" "Desired and History behind typed accessors." "Rust struct" {
            tags "Code"
        }
        coreDesired = component "state::desired::Desired" "This tick's commanded values and their written masks." "Rust struct, private" {
            tags "Code"
        }
        coreHistory = component "state::history::History" "Ring of State snapshots, newest first, each with the tick's Faults and TickFlags in a parallel ring." "Rust struct, private" {
            tags "Code"
        }
        coreField = component "state::StateField" "The sealed field bound; sealed::Slot routes each type to its storage." "Rust trait, sealed" {
            tags "Code"
        }
        coreValues = component "state::Q, Qd, Tau, Kp, Kd" "The typed values, never a bare f32." "Rust newtypes" {
            tags "Code"
        }
    }

    group "kmr_core: hardware contract" {
        coreHalTrait = component "hal::Hal" "The adapter contract, sealed to adapters." "Rust trait" {
            tags "Code"
        }
        coreMask = component "hal::Mask" "One bit per actuator." "Rust struct" {
            tags "Code"
        }
        coreIo = component "hal::Sample, Command, Batch, Written" "What a read fills and a write sends; Batch groups the written actuators in runs per Group." "Rust structs" {
            tags "Code"
        }
        coreFaults = component "hal::Faults, TickFlags" "Per-actuator fault masks and whole-tick flags of one tick, kept in its History slot." "Rust structs" {
            tags "Code"
        }
        coreStages = component "robot::Stages, Robot::run_on_staged" "Hidden hooks around each tick's controllers: inbound after read, before First; outbound after the write and end_tick. () is the no-stage default of run_on. Static dispatch." "Rust trait" {
            tags "Code"
        }
        coreExternalFlags = component "hal::ExternalFlags" "AtomicU32 of tick flags raised from any thread (fetch_or Release); the loop takes it (swap Acquire) after read, into the tick's slot. Apart from the signal bus." "Rust struct, hidden" {
            tags "Code"
        }
        coreNoHardware = component "hal::NoHardware" "The simulating member used when no plugin is given." "Rust struct" {
            tags "Code"
        }
    }

    group "kmr_core: driver set" {
        coreDrivers = component "hal::set::Drivers" "Implemented for HNil and HCons of Hal members; claim, step, read, write, hold, torque_off." "Rust trait, sealed" {
            tags "Code"
        }
        corePlan = component "hal::set::Plan, Claim, Coverage" "The merged claims and the coverage check." "Rust structs" {
            tags "Code"
        }
        coreHardwareError = component "hal::set::HardwareError, MemberError" "Which member, which step, the adapter's error typed inside." "Rust enums" {
            tags "Code"
        }
        coreAudit = component "hal::set::Audit" "Debug builds: records out-of-claim touches." "Rust struct" {
            tags "Code"
        }
    }

    coreRobot -> coreScheduled "Holds"
    coreRobot -> coreInsert "Adds through"
    coreInsert -> coreNodes "Appends"
    coreScheduled -> coreDrive "Implements"
    coreDrive -> coreRunPhase "Walks buckets with"
    coreNodes -> coreFnTraits "Hold a fn implementing"
    coreNodes -> coreEnv "Are called with"
    coreRobot -> coreRuntimeFn "run_on calls"
    coreRuntimeFn -> coreHost "Takes time and signals through"
    coreRuntimeFn -> corePowered "Guards the powered run with"
    coreRuntimeFn -> coreTime "Advances"
    coreRuntimeFn -> coreSignalType "Drains"
    coreSignalType -> coreSignalMeta "Points to"
    coreRobotState -> coreDesired "Stages writes in"
    coreRobotState -> coreHistory "Reads from"
    coreRobotState -> coreField "Is generic over"
    coreValues -> coreField "Implement"
    corePowered -> coreDrivers "Powers off"
    coreDrivers -> coreHalTrait "Calls"
    coreDrivers -> corePlan "Merges claims into"
    coreDrivers -> coreHardwareError "Fails with"
    coreDrivers -> coreAudit "Records into"
    coreHalTrait -> coreIo "Reads into and writes from"
    coreHalTrait -> coreFaults "Reports into"
    coreHistory -> coreFaults "Keeps per slot"
    coreRuntimeFn -> coreExternalFlags "Takes each tick through the Host"
    coreRuntimeFn -> coreStages "Calls around each tick's controllers"
    coreIo -> coreMask "Flags actuators with"
    coreNoHardware -> coreHalTrait "Implements"
}
