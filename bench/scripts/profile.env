# shellcheck shell=bash
# profile.env: every bench setting in one place, and bench_run, the step every script shares
# (research R3, R12, R14, R17, R18). Sourced by the scripts from the repository root.
#
# A setting already in the environment wins, so a dev host can run short (TICKS=6000).

# 1 kHz cells: 600 000 measured ticks plus the warm-up (research R18).
: "${TICKS:=601000}"
: "${WARMUP:=1000}"
# Hold of one ceiling or budget candidate, in s.
: "${HOLD_S:=60}"
# Ceiling search bounds in ns, and its stop: a bracket within 1 % (10 permille) of dt.
: "${CEIL_DT_MIN_NS:=10000}"
: "${CEIL_DT_MAX_NS:=1000000}"
: "${CEIL_STOP_PERMILLE:=10}"
# Budget search step, in ns.
: "${BUDGET_STEP_NS:=1000}"
# Registration counts of the FR-014 sweep; 123 is today's ceiling (research R21 P8).
: "${REG_COUNTS:=1 16 64 123}"
# Repeats of each compile-time figure.
: "${REPEATS:=3}"
# The load starts this many s before the run (research R17).
: "${LOAD_LEAD_S:=5}"
# Real-time policy and the CPU of the run.
: "${SCHED_PRIO:=80}"
: "${AFFINITY_CPU:=3}"
: "${GOVERNOR:=performance}"
# kmr's simulation warning, counted over stdout and stderr.
: "${SIM_WARNING:=no bus plugin: simulating}"
# Reports land in $REPORT_ROOT/<commit12>/<host_id>/.
: "${REPORT_ROOT:=bench/reports}"
# 1 runs without SCHED_FIFO when chrt is refused (a dev host without root); recorded in sched.
: "${BENCH_ALLOW_NONRT:=0}"
# Where the release binaries are: built once, the same binary runs on both kernels (FR-025).
: "${BENCH_BIN:=target/release}"

BENCH_SCRIPTS=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# The load command of a run of $1 s, all cores (research R17).
load_cmd() {
    printf 'stress-ng --cpu 0 --cpu-method all --hdd 1 --hdd-bytes 256M --timeout %ss' "$1"
}

# The path of bench binary $1, or a message naming the build command and exit 1.
bench_bin() {
    local path=$BENCH_BIN/$1
    if [[ ! -x $path ]]; then
        echo "bench: $path missing; build once: cargo build -p kmr_bench --release --bins" >&2
        return 1
    fi
    printf '%s' "$path"
}

# "rt" on a PREEMPT_RT kernel, else "nonrt": the first part of a cell id.
bench_kernel() {
    if [[ $( (source "$BENCH_SCRIPTS/meta.sh" && kernel_rt)) == yes ]]; then
        printf 'rt'
    else
        printf 'nonrt'
    fi
}

# The next free report path for measurement $2 and cell $3 in directory $1.
bench_next_report() {
    local n=1
    while [[ -e $1/$2-$3-$n.toml ]]; do n=$((n + 1)); done
    printf '%s/%s-%s-%s.toml' "$1" "$2" "$3" "$n"
}

# The [meta] and [run] blocks of report $1, with measurement $2 and cell $3, no [figures]: the
# head of a search's summary report (ceiling.sh, budget.sh, presort.sh).
bench_head() {
    awk -v m="$2" -v c="$3" '
        /^\[/ { block = $0 }
        block == "[figures]" { exit }
        block == "[run]" && $1 == "measurement" && $2 == "=" { print "measurement = \"" m "\""; next }
        block == "[run]" && $1 == "cell" && $2 == "=" { print "cell = \"" c "\""; next }
        { print }' "$1"
}

# The [run] keys only the binary knows, moved into [meta] (contracts/results-schema.md).
BENCH_COPIED_KEYS="robot robot_n buses controllers timer_slack_ns read_cadence declared_read_ns declared_write_ns"

# Flag names in report order.
BENCH_FLAG_ORDER="simulated not_reference throttled inconsistent uncalibrated alloc_seen"

# bench_run <binary> <measurement> <cell> [VAR=value ...]
#
# Runs one measurement process and writes one report plus its .log; prints the report path.
# The binary runs under chrt and taskset, RUST_LOG unset, with KMR_BENCH_OUT,
# KMR_BENCH_MEASUREMENT, KMR_BENCH_CELL and the given variables. The caller names the build in
# BENCH_PROFILE (default release) and BENCH_FEATURES (default none) and the load in
# BENCH_LOAD_COMMAND (default none); meta.sh gets them with BENCH_AFFINITY and BENCH_SCHED.
# BENCH_TIMEOUT_S, when set, ends it with SIGINT (never SIGTERM: no report on SIGTERM before
# core K1.2).
# Returns the binary's exit code, also after a timeout (the run is then `incomplete`, exit 0;
# never timeout's 124), or 1 when the metadata or the binary's report is missing.
bench_run() {
    local binary=$1 measurement=$2 cell=$3
    shift 3
    (
        set -euo pipefail
        unset RUST_LOG
        local commit host dir n report log tmp rc=0 sched
        local -a launch=()
        commit=$(git rev-parse --short=12 HEAD)
        host=$("$BENCH_SCRIPTS/meta.sh" host-id)
        dir=$REPORT_ROOT/$commit/$host
        mkdir -p "$dir"
        n=1
        while [[ -e $dir/$measurement-$cell-$n.toml ]]; do n=$((n + 1)); done
        report=$dir/$measurement-$cell-$n.toml
        log=${report%.toml}.log
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT

        if chrt -f "$SCHED_PRIO" true 2>/dev/null; then
            launch+=(chrt -f "$SCHED_PRIO")
            sched="SCHED_FIFO $SCHED_PRIO"
        elif [[ $BENCH_ALLOW_NONRT == 1 ]]; then
            sched=SCHED_OTHER
        else
            echo "bench_run: chrt -f $SCHED_PRIO refused (run as root, or BENCH_ALLOW_NONRT=1)" >&2
            exit 1
        fi
        launch=(taskset -c "$AFFINITY_CPU" "${launch[@]}")
        if [[ -n ${BENCH_TIMEOUT_S:-} ]]; then
            launch=(timeout --preserve-status -s INT "$BENCH_TIMEOUT_S" "${launch[@]}")
        fi

        export BENCH_AFFINITY=$AFFINITY_CPU BENCH_SCHED=$sched \
            BENCH_PROFILE=${BENCH_PROFILE:-release} BENCH_FEATURES=${BENCH_FEATURES:-} \
            BENCH_LOAD_COMMAND=${BENCH_LOAD_COMMAND:-none}
        if ! "$BENCH_SCRIPTS/meta.sh" start >"$tmp/meta.toml" 2>"$tmp/meta.err"; then
            cat "$tmp/meta.err" >&2
            {
                if [[ -s $tmp/meta.toml ]]; then
                    cat "$tmp/meta.toml"
                else
                    printf '[meta]\nschema = 1\nhost_id = "%s"\n' "$host"
                fi
                printf '[run]\nmeasurement = "%s"\ncell = "%s"\nstatus = "failed"\nflags = ""\n' \
                    "$measurement" "$cell"
                printf 'reason = "%s"\nticks_done = 0\n' "$(tr -d '"\n' <"$tmp/meta.err" | sed 's/^meta: //')"
            } >"$report"
            echo "$report"
            exit 1
        fi

        env KMR_BENCH_OUT="$tmp/run.toml" KMR_BENCH_MEASUREMENT="$measurement" \
            KMR_BENCH_CELL="$cell" "$@" "${launch[@]}" "$binary" >"$log" 2>&1 || rc=$?
        "$BENCH_SCRIPTS/meta.sh" end >>"$tmp/meta.toml"

        if [[ ! -s $tmp/run.toml ]]; then
            printf '[run]\nmeasurement = "%s"\ncell = "%s"\nstatus = "failed"\nflags = ""\n' \
                "$measurement" "$cell" >"$tmp/run.toml"
            printf 'reason = "no report from %s, exit %s"\nticks_done = 0\n' \
                "$(basename "$binary")" "$rc" >>"$tmp/run.toml"
            [[ $rc == 0 ]] && rc=1
        fi

        _bench_assemble "$tmp" "$log" >"$report"
        echo "$report"
        exit "$rc"
    )
}

# The value of key $2 in block $3 of report file $1, quotes removed; empty when absent.
bench_key() {
    awk -v key="$2" -v block="[$3]" '
        /^\[/ { in_block = ($0 == block); next }
        in_block && $1 == key && $2 == "=" {
            sub(/^[^=]*= */, ""); gsub(/"/, ""); print; exit
        }' "$1"
}

# True when throttled_start or throttled_end in [meta] of report file $1 shows a throttle. On a
# reference report a state that was not read ("unavailable" or absent) counts as one: such a
# run cannot show it was not throttled, so it stays out of comparisons.
bench_throttled() {
    local key reference
    reference=$(bench_key "$1" reference meta)
    for key in throttled_start throttled_end; do
        case $(bench_key "$1" "$key" meta) in
        0x0 | hwmon:0) ;;
        unavailable | "") [[ $reference == yes ]] && return 0 ;;
        *) return 0 ;;
        esac
    done
    return 1
}

# Prints the final report from $1/meta.toml and $1/run.toml, with the script's flags and
# sim_warning_count from log $2.
_bench_assemble() {
    local tmp=$1 log=$2 key line flags="" flag add="" buses warnings
    # Keys copied into [meta], left out of [run].
    for key in $BENCH_COPIED_KEYS; do
        line=$(grep -m1 "^$key = " "$tmp/run.toml" || true)
        [[ -n $line ]] && printf '%s\n' "$line" >>"$tmp/meta.toml"
    done

    [[ $(bench_key "$tmp/meta.toml" reference meta) == yes ]] || add+=" not_reference"
    if bench_throttled "$tmp/meta.toml"; then add+=" throttled"; fi
    warnings=$(grep -cF -- "$SIM_WARNING" "$log" || true)
    buses=$(bench_key "$tmp/run.toml" buses run)
    if [[ $buses == none && $warnings != 1 ]]; then add+=" inconsistent"; fi

    flags=$(bench_key "$tmp/run.toml" flags run)
    for flag in $BENCH_FLAG_ORDER; do
        if [[ ",$flags," == *",$flag,"* || " $add " == *" $flag "* ]]; then
            printf '%s\n' "$flag"
        fi
    done >"$tmp/flags"
    flags=$(paste -sd, "$tmp/flags")

    cat "$tmp/meta.toml"
    awk -v flags="$flags" -v copied=" $BENCH_COPIED_KEYS " '
        /^\[/ { block = $0 }
        block == "[run]" && index(copied, " " $1 " ") && $2 == "=" { next }
        block == "[run]" && $1 == "flags" && $2 == "=" { print "flags = \"" flags "\""; next }
        { print }' "$tmp/run.toml"
    if grep -q '^\[figures\]$' "$tmp/run.toml"; then
        printf 'sim_warning_count = %s\n' "$warnings"
    fi
}
