<?xml version="1.0"?>
<!-- Snake of ten RX-28 (ROBOTIS, Protocol 1), firmware ids 1..10 on one bus.
     Joints alternate yaw (z) and pitch (y). Module pitch 0.07 m, RX-28 72 g.
     Limits from the RX-28 e-Manual: +-2.618 rad, 8.901 rad/s, 3.7 N.m.
     Each <transmission> names the actuator behind its joint: the standard
     URDF place for "which actuator is what". -->
<robot name="rx28_snake">
  <link name="head">
    <inertial><origin xyz="0 0 0"/><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <link name="module1">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module2">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module3">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module4">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module5">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module6">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module7">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module8">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module9">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <link name="module10">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.072"/><inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.3e-5" iyz="0" izz="2.3e-5"/></inertial>
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.0506 0.0356 0.0355"/></geometry></collision>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="head"/>
    <child link="module1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="module1"/>
    <child link="module2"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="module2"/>
    <child link="module3"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="module3"/>
    <child link="module4"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="module4"/>
    <child link="module5"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="module5"/>
    <child link="module6"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint7" type="revolute">
    <parent link="module6"/>
    <child link="module7"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint8" type="revolute">
    <parent link="module7"/>
    <child link="module8"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint9" type="revolute">
    <parent link="module8"/>
    <child link="module9"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <joint name="joint10" type="revolute">
    <parent link="module9"/>
    <child link="module10"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" velocity="8.901" effort="3.7"/>
  </joint>
  <transmission name="trans1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint1"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="rx28_bus0_id1"><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint2"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="rx28_bus0_id2"><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans3">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint3"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="rx28_bus0_id3"><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans4">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint4"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="rx28_bus0_id4"><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans5">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint5"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
