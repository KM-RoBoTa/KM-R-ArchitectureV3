<?xml version="1.0"?>
<!-- Two snakes in one urdf, one tree under the link world: a snake of twelve
     AX-12A (ROBOTIS, Protocol 1), firmware ids 1..=12 on one bus, and a snake
     of ten RX-28 (Protocol 1), firmware ids 1..=10 on the RX bus. Two fixed
     joints hang head and rx_head off world; they are not actuated.
     AX-12A limits (e-Manual): +-2.618 rad, 6.178 rad/s (59 rpm), 1.5 N.m, 54.6 g.
     RX-28 limits (e-Manual): +-2.618 rad, 5.55 rad/s (53 rpm), 2.5 N.m, 72 g.
     Each <transmission> names the actuator behind its joint. -->
<robot name="ax12_12act_rx28_10act">
  <link name="world"/>
  <joint name="world_to_ax" type="fixed">
    <parent link="world"/>
    <child link="head"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="world_to_rx" type="fixed">
    <parent link="world"/>
    <child link="rx_head"/>
    <origin xyz="0 0.2 0" rpy="0 0 0"/>
  </joint>
  <link name="head">
