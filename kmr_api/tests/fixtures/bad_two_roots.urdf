<?xml version="1.0"?>
<!-- Bad test descriptor: two chains with no common root link. -->
<robot name="bad">
  <link name="base"/><link name="l1"/>
  <link name="other"/><link name="o1"/>
  <joint name="j1" type="revolute"><parent link="base"/><child link="l1"/><limit lower="-1.57" upper="1.57" velocity="3.0" effort="1.5"/></joint>
  <joint name="k1" type="revolute"><parent link="other"/><child link="o1"/><limit lower="-1.57" upper="1.57" velocity="3.0" effort="1.5"/></joint>
</robot>
